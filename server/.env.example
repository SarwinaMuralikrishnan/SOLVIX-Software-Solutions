# SOLVIX Backend Express Production Environment Configuration
# Render Web Service Port (Dynamically provided by Render at runtime)
PORT=5000

# Client Web Frontend URL (For Production CORS Security)
CLIENT_URL=https://www.solvixsoftwaresolutions.com

# Supabase Credentials (PostgreSQL Cloud Database)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Resend API Credentials (Automated Email Dispatcher)
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=SOLVIX Software Solutions <contact@solvixsoftwaresolutions.com>

# OpenAI API Key (For SOLVIX AI Chatbot Assistant)
OPENAI_API_KEY=your_openai_api_key_here

# Founder Admin Authentication & Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
JWT_SECRET=your_secure_random_jwt_secret_key_here
